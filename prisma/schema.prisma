generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum EventStatus {
  DRAFT
  ON_SALE
  SOLD_OUT
  CLOSED
  CANCELLED
}

enum ReservationStatus {
  LEAD
  PRE_RESERVED
  PAYMENT_PENDING
  WAITLIST
  HELD
  AWAITING_PAYMENT
  PAYMENT_UNCERTAIN
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum CommercialPlan {
  INDIVIDUAL
  DUO
  DUO_INDIVIDUAL
  GROUP
}

enum CommercialContactStatus {
  TO_CONTACT
  CONTACTED
  AWAITING_PAYMENT
  NO_RESPONSE
}

enum SeatPreferenceStatus {
  PREFERRED
  TEMPORARILY_HELD
  CONFIRMED
  RELEASED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  UNKNOWN
}

enum TicketLeg {
  OUTBOUND
  RETURN
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  passwordHash      String
  sessionVersion    Int                @default(1)
  role              UserRole           @default(OPERATOR)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs         AuditLog[]
  ticketValidations TicketValidation[]
  contactActivities ContactActivity[]
}

model Customer {
  id               String         @id @default(cuid())
  fullName         String
  phone            String         @unique
  email            String?
  marketingConsent Boolean        @default(false)
  consentUpdatedAt DateTime?
  crmExternalId    String?        @unique
  reservations     Reservation[]
  referralCodes    ReferralCode[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([email])
}

model Event {
  id                  String        @id @default(cuid())
  slug                String        @unique
  name                String
  venue               String
  eventDate           DateTime
  returnAt            DateTime?
  basePrice           Decimal       @db.Decimal(12, 2)
  currency            String        @default("AOA")
  capacity            Int
  salesOpenAt         DateTime?
  salesCloseAt        DateTime?
  ticketIncludesEntry Boolean       @default(false)
  status              EventStatus   @default(DRAFT)
  estimatedTravelDuration String?
  travelEstimateConfirmed Boolean   @default(false)
  routes              Route[]
  reservations        Reservation[]
  seatPreferences     SeatPreference[]
  discounts           Discount[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Route {
  id           String        @id @default(cuid())
  eventId      String
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int
  vehicleId    String?
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  pickupPoints PickupPoint[]
  reservations Reservation[]
  active       Boolean       @default(true)

  @@index([eventId])
}

model PickupPoint {
  id           String        @id @default(cuid())
  routeId      String
  route        Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name         String
  address      String
  departureAt  DateTime?
  operationalConfirmed Boolean @default(false)
  sortOrder    Int
  reservations Reservation[]

  @@unique([routeId, name])
}

model Vehicle {
  id           String  @id @default(cuid())
  name         String
  registration String  @unique
  capacity     Int
  routes       Route[]
}

model Reservation {
  id                 String                 @id @default(cuid())
  reference          String                 @unique
  eventId            String
  event              Event                  @relation(fields: [eventId], references: [id])
  routeId            String?
  route              Route?                 @relation(fields: [routeId], references: [id])
  pickupPointId      String?
  pickupPoint        PickupPoint?           @relation(fields: [pickupPointId], references: [id])
  customerId         String
  customer           Customer               @relation(fields: [customerId], references: [id])
  discountId         String?
  discount           Discount?              @relation(fields: [discountId], references: [id])
  status             ReservationStatus      @default(HELD)
  plan               CommercialPlan?
  pickupPreference   String?
  pickupOther        String?
  contactStatus      CommercialContactStatus @default(TO_CONTACT)
  operationalConfirmed Boolean              @default(false)
  quantity           Int
  unitPrice          Decimal                @db.Decimal(12, 2)
  discountAmount     Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal                @db.Decimal(12, 2)
  currency           String                 @default("AOA")
  holdExpiresAt      DateTime?
  paidAt             DateTime?
  idempotencyKey     String                 @unique
  termsAcceptedAt    DateTime?
  campaignSource     String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  referralInput      String?
  passengers         ReservationPassenger[]
  seatPreferences    SeatPreference[]
  contactActivities  ContactActivity[]
  payments           Payment[]
  referralRedemption ReferralRedemption?
  crmJobs            CRMIntegrationJob[]
  notifications      Notification[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([eventId, status])
  @@index([holdExpiresAt, status])
  @@index([discountId])
}

model ReservationPassenger {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fullName      String
  ticket        Ticket?

  @@index([reservationId])
}

model Payment {
  id                String                @id @default(cuid())
  reservationId     String
  reservation       Reservation           @relation(fields: [reservationId], references: [id])
  provider          String
  providerPaymentId String?               @unique
  idempotencyKey    String                @unique
  method            String
  status            PaymentStatus         @default(CREATED)
  amount            Decimal               @db.Decimal(12, 2)
  currency          String                @default("AOA")
  providerReference String?
  providerDetails   Json?
  rawStatus         String?
  reconciledAt      DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  webhookEvents     PaymentWebhookEvent[]

  @@index([reservationId, status])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  paymentId       String?
  payment         Payment?  @relation(fields: [paymentId], references: [id])
  providerEventId String    @unique
  type            String
  payload         Json
  signatureValid  Boolean
  processedAt     DateTime?
  receivedAt      DateTime  @default(now())
}

model Ticket {
  id          String               @id @default(cuid())
  passengerId String               @unique
  passenger   ReservationPassenger @relation(fields: [passengerId], references: [id])
  publicToken String               @unique @default(uuid())
  status      String               @default("VALID")
  issuedAt    DateTime             @default(now())
  revokedAt   DateTime?
  validations TicketValidation[]
}

model TicketValidation {
  id          String    @id @default(cuid())
  ticketId    String
  ticket      Ticket    @relation(fields: [ticketId], references: [id])
  leg         TicketLeg
  validatedAt DateTime  @default(now())
  operatorId  String
  operator    User      @relation(fields: [operatorId], references: [id])
  deviceId    String?

  @@unique([ticketId, leg])
  @@index([validatedAt])
}

model ReferralCode {
  id          String               @id @default(cuid())
  customerId  String               @unique
  customer    Customer             @relation(fields: [customerId], references: [id])
  code        String               @unique
  active      Boolean              @default(true)
  redemptions ReferralRedemption[]
  createdAt   DateTime             @default(now())
}

model ReferralRedemption {
  id             String       @id @default(cuid())
  referralCodeId String
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id])
  reservationId  String       @unique
  reservation    Reservation  @relation(fields: [reservationId], references: [id])
  amount         Decimal      @db.Decimal(12, 2)
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
}

model Discount {
  id             String        @id @default(cuid())
  eventId        String?
  event          Event?        @relation(fields: [eventId], references: [id])
  code           String        @unique
  type           String
  value          Decimal       @db.Decimal(12, 2)
  maxRedemptions Int?
  usedCount      Int           @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean       @default(true)
  reservations   Reservation[]

  @@index([eventId, active])
}

model SMSVerification {
  id          String    @id @default(cuid())
  phone       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lastSentAt  DateTime
  verifiedAt  DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, expiresAt])
}

model Notification {
  id                String              @id @default(cuid())
  reservationId     String?
  reservation       Reservation?        @relation(fields: [reservationId], references: [id])
  channel           NotificationChannel
  recipient         String
  template          String
  status            String              @default("PENDING")
  providerMessageId String?
  attempts          Int                 @default(0)
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([reservationId, channel, template])
  @@index([status, createdAt])
}

model SeatPreference {
  id            String               @id @default(cuid())
  eventId       String
  event         Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  seatNumber    Int
  status        SeatPreferenceStatus @default(PREFERRED)
  releasedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([eventId, status])
  @@index([reservationId])
}

model ContactActivity {
  id            String       @id @default(cuid())
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  outcome       CommercialContactStatus
  comment       String?
  createdAt     DateTime     @default(now())

  @@index([reservationId, createdAt])
}

model CRMIntegrationJob {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  kind          String      @default("SALE")
  status        JobStatus   @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([reservationId, kind])
  @@index([status, nextAttemptAt])
}

model RequestRateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
