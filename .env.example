DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/festgo"
AUTH_SECRET="generate-a-long-random-secret"
APP_URL="https://festgo.mazanga.digital"
SALES_ENABLED="false"
BOOKING_MODE="CHECKOUT"
PRE_RESERVATIONS_ENABLED="false"
PAYMENTS_ENABLED="false"
PAYMENTS_PROVIDER="wipay"
# Keep the current gateway available while adding É-Kwanza as a choice.
PAYMENTS_AVAILABLE_PROVIDERS="wipay"
PAYMENT_INVITE_TTL_HOURS="72"
RESERVATION_HOLD_MINUTES="30"
# Delays since reservation creation; second must be greater than first.
# Run /api/jobs/notifications at least every 5 minutes, before the hold expires.
ABANDONED_CHECKOUT_FOLLOWUP_MINUTES="10"
ABANDONED_CHECKOUT_SECOND_FOLLOWUP_MINUTES="20"
OTP_EXPIRATION_MINUTES="5"
MAX_OTP_ATTEMPTS="5"
CHECKOUT_REQUIRE_OTP="true"
PUBLIC_BASE_URL="https://festgo.mazanga.digital"
PAYMENTS_TEST_PRODUCT_ID="20d032f3-e0c2-48d3-8ce1-c93bc682dd37"

# Public analytics project identifier. Leave empty to disable Microsoft Clarity.
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# Payment API credentials (server-side only).
PAYMENTS_API_URL="https://rouxavcvorjiwhpjhsye.supabase.co/functions/v1/api-v1"
PAYMENTS_API_KEY=""
PAYMENTS_PRODUCT_INDIVIDUAL_ID=""
PAYMENTS_PRODUCT_DUO_ID=""
PAYMENTS_PRODUCT_DUO_INDIVIDUAL_ID=""
PAYMENTS_PRODUCT_GROUP_ID=""
PAYMENTS_WEBHOOK_SECRET=""

# WiPay Angola. The API host is shared; credentials determine sandbox/production.
WIPAY_ENVIRONMENT="sandbox"
WIPAY_API_URL="https://api.wipay.ao"
WIPAY_CALLBACK_URL="https://festgo.mazanga.digital/api/webhooks/wipay"
WIPAY_CLIENT_ID=""
WIPAY_CLIENT_SECRET=""

# É-Kwanza / é+ (GPO and Referência). PAYMENTS_PROVIDER remains the default;
# PAYMENTS_AVAILABLE_PROVIDERS exposes multiple gateways at checkout.
EKWANZA_AUTH_URL=""
EKWANZA_CHARGES_URL="https://gwy-api.appypay.co.ao/v2.0/charges"
EKWANZA_CLIENT_ID=""
EKWANZA_CLIENT_SECRET=""
EKWANZA_RESOURCE=""
EKWANZA_PAYMENT_METHOD_GPO=""
EKWANZA_PAYMENT_METHOD_REF=""
EKWANZA_API_KEY=""
EKWANZA_MERCHANT_IDENTIFIER=""

# Optional Ticket/QR flow and its signed callback.
EKWANZA_API_URL=""
EKWANZA_NOTIFICATION_TOKEN=""
EKWANZA_PARTNER_REGISTRATION=""

# Ziett transactional SMS credentials. The Sender ID is configured in the Ziett dashboard.
