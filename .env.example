ZIETT_SMS_REMITTER_ID=""

# Protects scheduled reconciliation, notifications and CRM jobs.
CRON_SECRET="generate-a-different-long-random-secret"

KUKUGEST_ENABLED="false"
KUKUGEST_API_URL="https://crm-mazanga.onrender.com/api/integrations/v1"
