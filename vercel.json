{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/jobs/notifications",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/jobs/reconcile-payments",
      "schedule": "10 1 * * *"
    },
    {
      "path": "/api/jobs/crm",
      "schedule": "20 1 * * *"
    },
    {
      "path": "/api/jobs/meta",
      "schedule": "30 1 * * *"
    }
  ]
}
